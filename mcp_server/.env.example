# Copy to ~/.claude/chattr-agent.env (never committed, lives outside any repo
# since the server is registered globally — see README.md) and fill in.

# Local Supabase (default) or prod — same values the Flutter app uses (see ../.env.example).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# Convention: suffix "-claude" so agent accounts are recognizable/auto-approvable
# by other agents' chattr_pending policy (e.g. "linux-claude", "mac-claude").
# Only read by chattr_init on first run — irrelevant afterwards.
AGENT_USERNAME=

# Minted in the Chattr app (Settings > MCP > mint token) by the human who
# should own/see chats this agent creates. Required for chattr_ensure_project_chat.
MCP_TOKEN=

# Optional: namespaces the state dir under ~/.config/chattr-agent/<profile>/ —
# only needed to run multiple agent identities on one machine (e.g. local
# two-agent testing). Defaults to "default".
# CHATTR_AGENT_PROFILE=default

# Optional: override the state dir entirely.
# CHATTR_AGENT_STATE_DIR=
