# Firebase (firebase_core/firebase_messaging) requires iOS 15+.
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # Native hybrid-KEM crypto (X25519 + ML-KEM-768). Build with `./native/build.sh apple`.
  pod 'chattr_crypto', :path => '.'

  # iOS Share Extension for share_handler. The models pod carries the
  # ShareHandlerIosViewController base class the extension subclasses, and is
  # shared with the host app via the app group.
  target 'ShareExtension' do
    inherit! :search_paths
    pod 'share_handler_ios_models', :path => '.symlinks/plugins/share_handler_ios/ios/Models'
  end

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end

  installer.pods_project.build_configurations.each do |config|
    config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] ||= '15.0'
  end

  # The ShareExtension's Info.plist versions come from $(FLUTTER_BUILD_NAME) /
  # $(FLUTTER_BUILD_NUMBER), but only the Runner target includes Flutter's
  # Generated.xcconfig. An app extension whose version does not match the host
  # is rejected at App Store upload, so we append an #include of Generated.xcconfig
  # to the extension's own (CocoaPods-owned) xcconfigs. Resolved at BUILD time —
  # always in sync with the app's version, no per-bump maintenance. Re-applied
  # here because CocoaPods regenerates these files on every `pod install`.
  support = File.join(__dir__, 'Pods', 'Target Support Files', 'Pods-ShareExtension')
  if Dir.exist?(support)
    include_line = '#include "../../../Flutter/Generated.xcconfig"'
    Dir.glob(File.join(support, 'Pods-ShareExtension.*.xcconfig')).each do |xc|
      body = File.read(xc)
      next if body.include?(include_line)
      File.write(xc, "#{include_line}\n#{body}")
    end
  end
end
