<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Debug/Profile: APNs sandbox. Release build uses RunnerRelease.entitlements
	     (aps-environment = production) for TestFlight/App Store. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Shared with the ShareExtension target so share_handler can hand shared
	     media from the extension to the app (UserDefaults + container URL). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.net.geraldhofbauer.chattr</string>
	</array>
</dict>
</plist>
