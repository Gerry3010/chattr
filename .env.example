# Supabase Configuration
# Copy this file to .env and fill in your values

# Supabase URL (Desktop/iOS)
SUPABASE_URL=http://127.0.0.1:54321

# Supabase URL (Android Emulator)
SUPABASE_ANDROID_URL=http://10.0.2.2:54321

# Supabase Anonymous Key
SUPABASE_ANON_KEY=your_anon_key_here

# Basis-URL für die Android-APK + ihr Update-Manifest (manifest.json).
# Update-Endpoint des Android-In-App-Updaters (CMS-Versions-Endpoint, liefert
# $BASE/manifest.json = latest Release). Pro Plattform ein eigener Base.
APP_DOWNLOAD_BASE=https://chattr.at/api/updates/android

# Wartungsschalter: solange diese Datei `{"maintenance": true}` liefert,
# loescht sich KEIN Geraet, auch wenn der Server sein Konto nicht kennt.
# Statisch ausgeliefert (Caddy `/download/`), bewusst UNABHAENGIG von Supabase —
# der Fall, gegen den sie schuetzt, ist ein kaputtes Backend. Nicht erreichbar
# heisst NICHT Wartung; die automatische Bremse ist die 72-Stunden-Karenz in
# `lib/core/init/account_gone_guard.dart`.
MAINTENANCE_URL=https://chattr.geraldhofbauer.net/download/maintenance.json
