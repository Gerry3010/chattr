# Firebase Cloud Messaging (HTTP v1 API)
#
# Paste the FULL service-account JSON as a single line, wrapped in SINGLE quotes
# (so the dotenv parser keeps the JSON's double-quotes instead of stripping them).
# Get it from Firebase Console → Project Settings → Service Accounts → "Generate
# new private key". The legacy FCM_SERVER_KEY no longer works (Google removed the
# legacy API in June 2024); v1 needs a service account to mint OAuth2 tokens.
FCM_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com",...}'

# Optional — overrides the project_id inside the service-account JSON.
FCM_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
