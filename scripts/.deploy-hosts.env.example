# Real deploy / SSH hosts, kept OUT of the public repo.
#
# Copy this to `scripts/.deploy-hosts.env` (gitignored) and fill in your own
# hosts. The ops scripts source that file automatically.
#
#   cp scripts/.deploy-hosts.env.example scripts/.deploy-hosts.env
#   # then edit scripts/.deploy-hosts.env

# scripts/deploy-apk-homepage.sh — the box that serves the APK download page.
CHATTR_HOMEPAGE_SSH=user@your-homepage-host

# scripts/sync-backend-version.sh — the box running the backend the app_versions
# table lives on.
CHATTR_BACKEND_SSH=user@your-backend-host
