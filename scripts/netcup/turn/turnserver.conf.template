# coturn for chattr calls. Generated by setup-turn.sh — edit the template in
# the repo (scripts/netcup/turn/), not this file.

listening-port=3478
listening-ip=__IPV4__
listening-ip=__IPV6__
relay-ip=__IPV4__
relay-ip=__IPV6__

# 200 ports, two per relayed call leg. Must match open-firewall.sh.
min-port=49160
max-port=49359

realm=turn.chattr.at
server-name=turn.chattr.at
fingerprint

# TURN REST API: credentials are HMAC(secret, "<expiry>:<random>"), minted by
# public.get_call_ice_servers (00086) from the same secret in Vault.
use-auth-secret
static-auth-secret=__SECRET__

# Plain UDP/TCP on 3478 only. TLS on 443 (for networks that block everything
# else) would collide with Caddy and is a later step.
no-tls
no-dtls
no-cli
# To stdout, where the compose file's `logging: driver: none` drops it. The
# default is a file under /var/tmp — on a read-only container, invisible.
log-file=stdout
no-software-attribute
no-rfc5780
no-multicast-peers
# WebRTC relays UDP; a TCP relay would turn this into a general proxy.
no-tcp-relay

# A relay must never reach into the box or a private network. Without these,
# anyone with a credential could talk to Kong, Postgres or the docker
# bridges through it — those listen on 127.0.0.1 and the 172.x bridges.
#
# The box's OWN public addresses are deliberately NOT denied: when both sides
# use the relay (the "route through the server" setting), relay A sends to
# relay B on this very IP. Denying it broke exactly that case (found by the
# relay loopback test). What listens on the public IP (Caddy 80/443, sshd) is
# public anyway.
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.0.0.0-192.0.0.255
denied-peer-ip=192.0.2.0-192.0.2.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=198.18.0.0-198.19.255.255
denied-peer-ip=198.51.100.0-198.51.100.255
denied-peer-ip=203.0.113.0-203.0.113.255
denied-peer-ip=224.0.0.0-255.255.255.255
denied-peer-ip=::1
# IPv4-mapped IPv6 (::ffff:a.b.c.d): coturn < 4.18 compared these literally,
# so ::ffff:127.0.0.1 slipped past the IPv4 lines above (CVE-2026-27624,
# CVE-2026-53450, CHAT-46). 4.18 canonicalises them; this line stays as a
# second lock. Mixed notation, because 4.18 refuses to start on a malformed
# entry: checked against the image before deploying.
denied-peer-ip=::ffff:0.0.0.0-::ffff:255.255.255.255
denied-peer-ip=64:ff9b::-64:ff9b::ffff:ffff
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff

# Limits against misuse as a free bandwidth relay. One device takes up to
# four allocations per call (UDP/TCP × IPv4/IPv6); a quota of 4 ran out in
# the loopback test. Audio needs ~50 kbit/s;
# 125000 bytes/s (1 Mbit/s) per session leaves room, a video call later
# will need more.
max-bps=125000
user-quota=12
total-quota=200
stale-nonce=600
